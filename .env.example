# Copy to .env.local for local development (git-ignored). On the server the same variables live
# in /opt/kopecjan/.env (mode 600). Real values never go into this file.

# Server only. Never expose these to the client.
ANTHROPIC_API_KEY=            # Claude API key for /api/ask; empty = the assistant always answers with the fallback
ALTCHA_HMAC_KEY=              # secret for signing proof-of-work challenges, e.g. `openssl rand -hex 32`;
                              # empty = a random key per process (fine for local dev)

# Assistant (all optional, defaults shown)
RAG_MODEL=claude-haiku-5-5    # or claude-sonnet-5-5 for better answers at higher cost
RAG_SCORE_THRESHOLD=0.784     # best cosine similarity below this = fallback without calling the model
                              # (tuned for multilingual-e5-small, re-check with `pnpm test:rag --verbose`)

# Limits (optional, defaults shown)
RATE_LIMIT_PER_HOUR=10        # questions per client (hashed IP) per sliding hour
DAILY_CAP=500                 # questions per day for the whole site, reset at midnight UTC

# Embeddings run locally (multilingual-e5-small via transformers.js), no API key needed.
EMBED_CACHE_DIR=              # where the model is stored; default .cache/models, /app/models in Docker
EMBED_ALLOW_DOWNLOAD=         # "false" in the Docker image, so production never downloads at request time

# Site (public, inlined at build time)
NEXT_PUBLIC_SITE_URL=https://kopecjan.cz
NEXT_PUBLIC_CHAT_ENABLED=false        # true switches the chat on; false shows the "Coming soon" placeholder
NEXT_PUBLIC_ANALYTICS_URL=            # optional Plausible / Umami script URL; empty = analytics off
NEXT_PUBLIC_ANALYTICS_SITE_ID=        # Umami website id (Plausible needs only the URL)

# Build
NEXT_OUTPUT=                  # "standalone" for the Docker image (set in the Dockerfile and CI)
