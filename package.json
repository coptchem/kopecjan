{
  "name": "kopecjan",
  "version": "0.1.0",
  "private": true,
  "description": "kopecjan.cz, personal website of Jan Kopecký",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-dashes.ts && tsx scripts/build-index.ts && next build",
    "start": "next start",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check-dashes": "tsx scripts/check-dashes.ts",
    "index": "tsx scripts/build-index.ts",
    "index:docker": "bash scripts/index-docker.sh",
    "test:rag": "tsx scripts/test-rag.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@huggingface/transformers": "^4.3.2",
    "altcha-lib": "^2.10.0",
    "next": "15.5.29",
    "next-intl": "4.15.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
